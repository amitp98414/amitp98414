generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  DOMAIN
  IP
  APPLICATION
  API
  REPOSITORY
  CONTAINER
  CLOUD_RESOURCE
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  UNKNOWN
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets     Asset[]
  auditEvents AuditEvent[]
}

model Asset {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  type          AssetType
  environment   Environment  @default(UNKNOWN)
  status        AssetStatus  @default(ACTIVE)
  owner         String
  criticality   Int          @default(3)
  identifier    String
  tags          String[]
  lastScannedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@index([environment])
  @@index([status])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  action      String
  actor       String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
